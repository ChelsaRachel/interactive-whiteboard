# Salin ke backend/.env lalu isi.
# Kunci API Gemini (gratis dari https://aistudio.google.com/apikey) untuk asisten AI (tahap 5).
GEMINI_API_KEY=
# Model Gemini untuk asisten AI.
GEMINI_MODEL=gemini-3.5-flash-lite

# Model pengenal rumus default: texteller (lebih akurat, ~1 dtk) atau pix2text (lebih cepat, ~0,2 dtk).
RECOGNIZER_MODEL=texteller
# Jumlah thread CPU untuk ONNX Runtime.
RECOGNIZER_THREADS=16
