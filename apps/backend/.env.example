# Salin ke apps/backend/.env lalu isi.
# Kunci API OpenAI untuk asisten AI.
OPENAI_API_KEY=
# Model OpenAI untuk asisten AI.
OPENAI_MODEL=gpt-5.4-mini
# Opsional: lokasi file memory dan riwayat sesi asisten AI.
CHAT_HISTORY_PATH=chat_history.json

# Model pengenal rumus default: texteller (lebih akurat, ~1 dtk) atau pix2text (lebih cepat, ~0,2 dtk).
RECOGNIZER_MODEL=texteller
# Jumlah thread CPU untuk ONNX Runtime.
RECOGNIZER_THREADS=16
